# ── Test Mode (Mock-Daten statt echter KI-API) ────────────────
# Setze TEST_MODE=true für lokale Entwicklung ohne Internet/KI-API
TEST_MODE=false

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_USER=newsletter
POSTGRES_PASSWORD=newsletter_secret
POSTGRES_DB=newsletter

# ── Admin ───────────────────────────────────────────────────────
ADMIN_PASSWORD=dein-admin-passwort

# ── Session Secret (für JWT Signierung) ─────────────────────────
SESSION_SECRET=ein-sehr-langes-zufälliges-secret-mindestens-32-zeichen

# ── KI-API (Gemini / OpenAI / etc.) ─────────────────────────────
AI_API_KEY=dein-api-key-hier-einfuegen
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-2.5-flash
