# ════════════════════════════════════════════════════════════════
#  AI Newsletter Hub — Umgebungsvariablen (für docker-compose / Coolify)
#  In Coolify unter "Environment Variables" eintragen.
# ════════════════════════════════════════════════════════════════

# ── PostgreSQL (wird vom db-Service genutzt) ────────────────────
POSTGRES_USER=newsletter
POSTGRES_PASSWORD=ein-sicheres-db-passwort
POSTGRES_DB=newsletter

# ── Admin-Login ─────────────────────────────────────────────────
# Login: Benutzer "admin" + dieses Passwort
ADMIN_PASSWORD=dein-sicheres-admin-passwort

# ── Session-Secret (JWT-Signierung, min. 32 Zeichen) ────────────
SESSION_SECRET=ein-sehr-langer-zufaelliger-string-mindestens-32-zeichen

# ── Port (Host-Port der App; Coolify mappt die Domain darauf) ───
APP_PORT=3000

# ── KI-API (OPTIONAL) ───────────────────────────────────────────
# Kann leer bleiben und stattdessen direkt in der Admin-UI unter
# "Einstellungen" eingegeben werden (empfohlen).
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-3.1-flash-lite

# TEST_MODE=true -> Mock-Daten statt echter KI (zum Ausprobieren ohne Key)
TEST_MODE=false
